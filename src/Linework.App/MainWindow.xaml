<Window x:Class="Linework.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linework"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Loaded="Window_Loaded"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Linework" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Today first. Done remembered." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,24" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Name}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,8"
                                    Padding="12,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding SelectedViewName}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedViewDescription}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" />
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,16">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsQuickAdd}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <Button DockPanel.Dock="Right"
                                Content="Add"
                                Command="{Binding AddTaskCommand}"
                                IsDefault="True"
                                MinWidth="84"
                                Padding="14,8"
                                Margin="10,0,0,0" />
                        <TextBox Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 VerticalContentAlignment="Center"
                                 FontSize="14" />
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding TaskListMessage}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Tasks}"
                             SelectedItem="{Binding SelectedTaskRow, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Button Content="Plan today"
                                                    Command="{Binding DataContext.PlanTodayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanPlanToday}"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanPlanToday}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Done"
                                                    Command="{Binding DataContext.MarkDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanMarkDone}"
                                                    Padding="12,6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0" Padding="22">
            <StackPanel>
                <TextBlock Text="Task Details" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TaskDetailsMessage}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedTask}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedTask}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox Text="{Binding EditableTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,16"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="False" />

                    <TextBlock Text="Status" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTaskDetails.StatusText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,12" />

                    <TextBlock Text="Planned" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTaskDetails.PlannedDateText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,12" />

                    <TextBlock Text="Due" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTaskDetails.DueDateText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,12" />

                    <TextBlock Text="Completed" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTaskDetails.CompletedDateText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,12" />

                    <TextBlock Text="Project" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTaskDetails.ProjectNameText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,12" />

                    <TextBlock Text="Notes" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableTaskNotes, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,12"
                             Padding="10,8"
                             MinHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             AcceptsReturn="True" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Save"
                                Command="{Binding SaveTaskDetailsCommand}"
                                Padding="14,8"
                                MinWidth="84" />
                        <TextBlock Text="{Binding TaskDetailsStatusMessage}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
