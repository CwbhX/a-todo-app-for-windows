<Window x:Class="Linework.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linework"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Linework" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Today first. Done remembered." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,24" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Name}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,8"
                                    Padding="12,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding SelectedViewName}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedViewDescription}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" />
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Phase 1 shell" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Task lists, quick add, details editing, and persistence-backed UI arrive in the next phases." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0" Padding="22">
            <StackPanel>
                <TextBlock Text="Task Details" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="No task selected" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18" />
                <TextBlock Text="This panel is reserved for title, project, important star, dates, reminders, markdown notes, archive, and reopen actions." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
